# Copy to .env and fill in. NEVER commit a real .env.
DEVICE_API_KEY=demo-device-key

# NOAA CO-OPS (no key required). 8775296 = USS Lexington, Corpus Christi Bay (water level).
NOAA_STATION_ID=8775296

# GCOOS ERDDAP (no key required). CBI_042 = Conrad Blucher Institute, Corpus Christi.
GCOOS_BASE_URL=https://erddap.gcoos.org/erddap
GCOOS_STATION=CBI_042

# Monitoring defaults (DEMO values, not regulatory standards).
ESCALATE_INDEX_DELTA=30
ESCALATE_PERSIST_SECONDS=15
RECOVER_INDEX_DELTA=15
RECOVER_PERSIST_SECONDS=12
